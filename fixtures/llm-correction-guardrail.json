      "input": "я завтра пойду в магазин",
      "output": "Я завтра пойду в магазин",
      "expect": "accept",
      "source": "macos",
      "why": "single-character leading word kept"
    },
    {
      "input": "please send me the report",
      "output": "Please send me the report",
      "expect": "accept",
      "source": "macos",
      "why": "Latin leading word"
    },
    {
      "input": "гитхаб релиз готов",
      "output": "GitHub релиз готов",
      "expect": "accept",
      "source": "macos",
